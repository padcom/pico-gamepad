// The Linux ioctl request numbers and event codes of evdev (<linux/input.h>, <linux/input-event-codes.h>) and joydev
// (<linux/joystick.h>), built as the kernel's _IOC macro does on x86-64 and arm64 (the generic layout: direction in bits 30-31, size
// in 16-29, type in 8-15, number in 0-7). Pure: no device is touched here, so it builds and is tested on every platform.

/// _IOC_WRITE and _IOC_READ.
export const IOC_WRITE: int = 1
export const IOC_READ: int = 2

/// The kernel's `_IOC(dir, type, nr, size)`.
export function ioc(dir: int, type: int, nr: int, size: int): int {
  return (dir << 30) | (size << 16) | (type << 8) | nr
}

/// 'E' (evdev) and 'j' (joydev).
const EVDEV: int = 69
const JOYDEV: int = 106

/// `EVIOCGVERSION`: the driver's version (an int).
export function eviocgversion(): int {
  return ioc(IOC_READ, EVDEV, 0x01, 4)
}

/// `EVIOCGID`: `struct input_id` (bustype, vendor, product, version: four u16).
export function eviocgid(): int {
  return ioc(IOC_READ, EVDEV, 0x02, 8)
}

/// `EVIOCGNAME(len)`, `EVIOCGPHYS(len)` and `EVIOCGUNIQ(len)`: text of at most `len` bytes.
export function eviocgname(len: int): int {
  return ioc(IOC_READ, EVDEV, 0x06, len)
}

export function eviocgphys(len: int): int {
  return ioc(IOC_READ, EVDEV, 0x07, len)
}

export function eviocguniq(len: int): int {
  return ioc(IOC_READ, EVDEV, 0x08, len)
}

/// `EVIOCGKEY(len)`: the bitmap of the keys and buttons that are pressed NOW (the kernel's state).
export function eviocgkey(len: int): int {
  return ioc(IOC_READ, EVDEV, 0x18, len)
}

/// `EVIOCGBIT(ev, len)`: the bitmap of the event codes of type `ev` the device has (`ev` 0: the types).
export function eviocgbit(ev: int, len: int): int {
  return ioc(IOC_READ, EVDEV, 0x20 + ev, len)
}

/// The size of `struct input_absinfo`: value, minimum, maximum, fuzz, flat, resolution (six s32).
export const ABSINFO_BYTES: int = 24

/// `EVIOCGABS(abs)`: the `struct input_absinfo` of an axis, with its value NOW.
export function eviocgabs(abs: int): int {
  return ioc(IOC_READ, EVDEV, 0x40 + abs, ABSINFO_BYTES)
}

/// `JSIOCGVERSION`, `JSIOCGAXES` and `JSIOCGBUTTONS` (joydev): an u32, an u8 and an u8.
export function jsiocgversion(): int {
  return ioc(IOC_READ, JOYDEV, 0x01, 4)
}

export function jsiocgaxes(): int {
  return ioc(IOC_READ, JOYDEV, 0x11, 1)
}

export function jsiocgbuttons(): int {
  return ioc(IOC_READ, JOYDEV, 0x12, 1)
}

/// `JSIOCGNAME(len)`: the device's name.
export function jsiocgname(len: int): int {
  return ioc(IOC_READ, JOYDEV, 0x13, len)
}

/// `JSIOCGAXMAP`: which ABS code each joydev axis number is (ABS_CNT = 64 bytes).
export function jsiocgaxmap(): int {
  return ioc(IOC_READ, JOYDEV, 0x32, 64)
}

/// `JSIOCGBTNMAP`: which key code each joydev button number is ((KEY_MAX - BTN_MISC + 1) u16 = 1024 bytes).
export function jsiocgbtnmap(): int {
  return ioc(IOC_READ, JOYDEV, 0x34, 1024)
}

// Event types (EV_*).
export const EV_SYN: int = 0
export const EV_KEY: int = 1
export const EV_REL: int = 2
export const EV_ABS: int = 3

// How many codes there are (ABS_CNT, KEY_CNT) and the last one (ABS_MAX, KEY_MAX).
export const ABS_MAX: int = 0x3f
export const KEY_MAX: int = 0x2ff

// Where the button ranges begin (BTN_*): the first of "misc", of the mouse, of the joystick, of the gamepad, of the digitiser.
export const BTN_MISC: int = 0x100
export const BTN_MOUSE: int = 0x110
export const BTN_JOYSTICK: int = 0x120
export const BTN_GAMEPAD: int = 0x130
export const BTN_DIGI: int = 0x140
export const BTN_TOOL_FINGER: int = 0x145
export const BTN_TOUCH: int = 0x14a
export const BTN_TRIGGER_HAPPY: int = 0x2c0

// The js_event of joydev: 8 bytes (u32 time, s16 value, u8 type, u8 number), and its type bits.
export const JS_EVENT_BYTES: int = 8
export const JS_EVENT_BUTTON: int = 0x01
export const JS_EVENT_AXIS: int = 0x02
export const JS_EVENT_INIT: int = 0x80

const ABS_NAMES: string[] = [
  "ABS_X", "ABS_Y", "ABS_Z", "ABS_RX", "ABS_RY", "ABS_RZ", "ABS_THROTTLE", "ABS_RUDDER",
  "ABS_WHEEL", "ABS_GAS", "ABS_BRAKE",
]

const ABS_HATS: string[] = ["ABS_HAT0X", "ABS_HAT0Y", "ABS_HAT1X", "ABS_HAT1Y", "ABS_HAT2X", "ABS_HAT2Y", "ABS_HAT3X", "ABS_HAT3Y"]

/// `n` as lower case hex, at least `width` digits.
export function hex(n: int, width: int): string {
  const digits = "0123456789abcdef"
  let s = ""
  let rest = n
  if (rest <= 0) {
    s = "0"
  }
  while (rest > 0) {
    s = `${digits[rest & 15]}${s}`
    rest = rest >> 4
  }
  return s.padStart(width, "0")
}

/// The kernel's name of an ABS code (`ABS_X`), or `ABS_0x..` for one that is not worth a table.
export function absName(code: int): string {
  if (code >= 0 && code < ABS_NAMES.length) {
    return ABS_NAMES[code]
  }
  if (code >= 0x10 && code < 0x18) {
    return ABS_HATS[code - 0x10]
  }
  return match (code) {
    0x18 => "ABS_PRESSURE",
    0x19 => "ABS_DISTANCE",
    0x1a => "ABS_TILT_X",
    0x1b => "ABS_TILT_Y",
    0x1c => "ABS_TOOL_WIDTH",
    0x20 => "ABS_VOLUME",
    0x21 => "ABS_PROFILE",
    0x28 => "ABS_MISC",
    _ => `ABS_0x${hex(code, 2)}`,
  }
}

const JOYSTICK_KEYS: string[] = [
  "BTN_TRIGGER", "BTN_THUMB", "BTN_THUMB2", "BTN_TOP", "BTN_TOP2", "BTN_PINKIE", "BTN_BASE", "BTN_BASE2",
  "BTN_BASE3", "BTN_BASE4", "BTN_BASE5", "BTN_BASE6", "BTN_0x12c", "BTN_0x12d", "BTN_0x12e", "BTN_DEAD",
]

const GAMEPAD_KEYS: string[] = [
  "BTN_SOUTH", "BTN_EAST", "BTN_C", "BTN_NORTH", "BTN_WEST", "BTN_Z", "BTN_TL", "BTN_TR", "BTN_TL2", "BTN_TR2",
  "BTN_SELECT", "BTN_START", "BTN_MODE", "BTN_THUMBL", "BTN_THUMBR",
]

/// The kernel's name of a key or button code (`BTN_TRIGGER`), or `KEY_0x..` for one that is not worth a table.
export function keyName(code: int): string {
  if (code >= BTN_MISC && code < BTN_MISC + 10) {
    return `BTN_${code - BTN_MISC}`
  }
  if (code >= BTN_JOYSTICK && code < BTN_JOYSTICK + JOYSTICK_KEYS.length) {
    return JOYSTICK_KEYS[code - BTN_JOYSTICK]
  }
  if (code >= BTN_GAMEPAD && code < BTN_GAMEPAD + GAMEPAD_KEYS.length) {
    return GAMEPAD_KEYS[code - BTN_GAMEPAD]
  }
  if (code >= BTN_TRIGGER_HAPPY && code <= KEY_MAX) {
    return `BTN_TRIGGER_HAPPY${code - BTN_TRIGGER_HAPPY + 1}`
  }
  return `KEY_0x${hex(code, 3)}`
}
