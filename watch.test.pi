// Hot-plug over the fake system: what is told, in which order, and what the ACL's lag does.
import { describe, it, expect } from "std/test"
import { delay } from "std/timers"
import { FakeSystem, fakeInfo } from "./fake"
import { watchPads } from "./watch"
import { OpenedPad, PadError, PadEvent, PadInfo, PadSystem, WatchOptions } from "./types"

const FAST: WatchOptions = { intervalMs: 10, denyAfterMs: 120 }
const LAGGY: WatchOptions = { intervalMs: 10, denyAfterMs: 2000 }
const PATIENT: WatchOptions = { intervalMs: 10, denyAfterMs: 5000 }

function pad(n: int): PadInfo {
  return fakeInfo(`Pad ${n}`, 0x1209, 0x4f54 + n, 8, 24, `S${n}`, `usb-${n}`, `/dev/input/event${n}`)
}

/// What a watch told: `kind path code`, in order.
class Told {
  public lines: string[] = []

  public add(e: PadEvent): void {
    lines.push(`${e.kind} ${e.pad.path}${if (e.code == "") "" else ` ${e.code}`}`)
  }
}

async function until(done: () => bool): Promise<void> throws Error {
  for (let i = 0; i < 400 && !done(); i++) {
    await delay(5)
  }
}

async function whatIsThereIsToldAtOnceThenTheChanges(): Promise<void> throws Error {
  const system = new FakeSystem()
  system.plug(pad(1))
  const told = new Told()
  const watch = watchPads((e: PadEvent) => told.add(e), FAST, system)
  await until(() => told.lines.length >= 1)
  expect(told.lines.join("|")).toBe("added /dev/input/event1")
  system.plug(pad(2))
  await until(() => told.lines.length >= 2)
  system.unplug("/dev/input/event1")
  await until(() => told.lines.length >= 3)
  watch.stop()
  await watch.done()
  expect(told.lines.join("|")).toBe("added /dev/input/event1|added /dev/input/event2|removed /dev/input/event1")
}

async function aLagOfTheAclIsNotADenial(): Promise<void> throws Error {
  const system = new FakeSystem()
  system.denyOpens = 3
  const told = new Told()
  const watch = watchPads((e: PadEvent) => told.add(e), LAGGY, system)
  system.plug(pad(1))
  await until(() => told.lines.length >= 1)
  watch.stop()
  await watch.done()
  // refused three times, then it opened: told once, as added
  expect(told.lines.join("|")).toBe("added /dev/input/event1")
  expect(system.opens >= 4).toBe(true)
}

async function aPadThatNeverOpensIsDeniedOnceAfterTheTime(): Promise<void> throws Error {
  const system = new FakeSystem()
  system.denyOpens = 1000000
  system.plug(pad(1))
  const told = new Told()
  const watch = watchPads((e: PadEvent) => told.add(e), FAST, system)
  await delay(60)
  expect(told.lines.length).toBe(0)
  await until(() => told.lines.length >= 1)
  await delay(80)
  watch.stop()
  await watch.done()
  expect(told.lines.join("|")).toBe("denied /dev/input/event1 PERMISSION_DENIED")
}

async function aPadThatWentWhileWaitingIsNotTold(): Promise<void> throws Error {
  const system = new FakeSystem()
  system.denyOpens = 1000000
  const told = new Told()
  const watch = watchPads((e: PadEvent) => told.add(e), FAST, system)
  system.plug(pad(1))
  await delay(30)
  system.unplug("/dev/input/event1")
  await delay(200)
  watch.stop()
  await watch.done()
  expect(told.lines.length).toBe(0)
}

async function nothingIsToldAfterStop(): Promise<void> throws Error {
  const system = new FakeSystem()
  const told = new Told()
  const watch = watchPads((e: PadEvent) => told.add(e), FAST, system)
  await delay(30)
  watch.stop()
  await watch.done()
  const scans = system.scans
  system.plug(pad(1))
  await delay(60)
  expect(told.lines.length).toBe(0)
  expect(system.scans).toBe(scans)
}

/// A system whose only pad is refused at once as not a pad's to open (a node that is not a joystick).
class NotAPad implements PadSystem {
  public async scan(): Promise<PadInfo[]> {
    return [pad(1)]
  }

  public async open(_info: PadInfo): Promise<OpenedPad> throws PadError {
    throw new PadError("NOT_A_PAD", "not a joystick")
  }
}

async function aNodeThatIsNotAPadIsDeniedAtOnce(): Promise<void> throws Error {
  const told = new Told()
  const watch = watchPads((e: PadEvent) => told.add(e), PATIENT, new NotAPad())
  await until(() => told.lines.length >= 1)
  watch.stop()
  await watch.done()
  expect(told.lines.join("|")).toBe("denied /dev/input/event1 NOT_A_PAD")
}

describe("watching what is plugged in", () => {
  it("tells what is there at once, then every change in order", whatIsThereIsToldAtOnceThenTheChanges)
  it("does not take the lag of the ACL for a denial", aLagOfTheAclIsNotADenial)
  it("says denied, once, for a pad that never opens", aPadThatNeverOpensIsDeniedOnceAfterTheTime)
  it("tells nothing of a pad that went while it waited", aPadThatWentWhileWaitingIsNotTold)
  it("tells nothing and looks at nothing after stop", nothingIsToldAfterStop)
  it("denies at once a node that is not a pad", aNodeThatIsNotAPadIsDeniedAtOnce)
})
